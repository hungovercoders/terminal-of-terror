# Recorded by docs/demos/render.sh, which fills in the theme from theme.json.
# Don't run vhs on this file directly.
Output docs/demos/.frames/mash/
Set Shell bash
Set FontSize 15
Set Width 1000
Set Height 700
Set Padding 24
Set TypingSpeed 60ms
Set Theme @theme.json
Set Framerate 50

Sleep 400ms
Type "terminal-of-terror mash dracula 'wolf man'"
Sleep 300ms
Enter
Sleep 8s
