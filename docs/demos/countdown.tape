# Recorded by docs/demos/render.sh, which fills in the theme from theme.json.
# Don't run vhs on this file directly.
Output docs/demos/.frames/countdown/
Set Shell bash
Set FontSize 15
Set Width 900
Set Height 480
Set Padding 24
Set TypingSpeed 60ms
Set Theme @theme.json
Set Framerate 50

Type "terminal-of-terror countdown --date 2026-10-13"
Enter
Sleep 2s
