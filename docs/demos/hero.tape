# Recorded by docs/demos/render.sh. Don't run vhs on this file directly.
Output docs/demos/.frames/hero/
Set Shell bash
Set FontSize 15
Set Width 1100
Set Height 700
Set Padding 24
Set TypingSpeed 60ms
Set Theme {"name": "Creature Feature", "background": "#0d0a12", "foreground": "#ece8e1", "cursor": "#ff7a1a", "selection": "#44475a", "black": "#21222c", "red": "#ff5555", "green": "#50fa7b", "yellow": "#f1fa8c", "blue": "#bd93f9", "purple": "#ff79c6", "cyan": "#8be9fd", "white": "#f8f8f2", "brightBlack": "#6272a4", "brightRed": "#ff6e6e", "brightGreen": "#69ff94", "brightYellow": "#ffffa5", "brightBlue": "#d6acff", "brightPurple": "#ff92df", "brightCyan": "#a4ffff", "brightWhite": "#ffffff"}

Sleep 400ms
Type "terminal-of-terror monster"
Sleep 300ms
Enter
Sleep 6.5s
Type "x"
Sleep 3s
Tab
Sleep 2.5s
Tab
Sleep 2.5s
Tab
Sleep 1.5s
Type "r"
Sleep 3s
Type "1"
Sleep 400ms
Right
Sleep 700ms
Right
Sleep 700ms
Right
Sleep 700ms
Right
Sleep 700ms
Right
Sleep 700ms
Right
Sleep 3.5s
Type "/"
Sleep 300ms
Type "silver"
Sleep 1.5s
Enter
Sleep 2.5s
Type "g"
Sleep 3s
Type "q"
Sleep 2.5s
