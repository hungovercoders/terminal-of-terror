# Recorded by docs/demos/render.sh, which fills in the theme from theme.json.
# Don't run vhs on this file directly.
Output docs/demos/.frames/hero/
Set Shell bash
Set FontSize 15
Set Width 1100
Set Height 700
Set Padding 24
Set TypingSpeed 60ms
Set Theme @theme.json
Set Framerate 50

Sleep 400ms
Type "terminal-of-terror monster"
Sleep 300ms
Enter
Sleep 6.5s
Type "x"
Sleep 3s
Tab
Sleep 2.5s
Tab
Sleep 2.5s
Tab
Sleep 1.5s
Type "r"
Sleep 3s
Type "1"
Sleep 400ms
Right
Sleep 700ms
Right
Sleep 700ms
Right
Sleep 700ms
Right
Sleep 700ms
Right
Sleep 700ms
Right
Sleep 3.5s
Type "/"
Sleep 300ms
Type "silver"
Sleep 1.5s
Enter
Sleep 2.5s
Type "g"
Sleep 3s
Type "q"
Sleep 2.5s
