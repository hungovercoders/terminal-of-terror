# Recorded by docs/demos/render.sh, which fills in the theme from theme.json.
# Don't run vhs on this file directly.
Output docs/demos/.frames/guess/
Set Shell bash
Set FontSize 15
Set Width 1000
Set Height 620
Set Padding 24
Set TypingSpeed 60ms
Set Theme @theme.json
Set Framerate 50

Sleep 400ms
Type "terminal-of-terror guess -n 1"
Sleep 300ms
Enter
Sleep 2s
Space
Sleep 1.5s
Space
Sleep 2.5s
Type "1"
Sleep 3.5s
Enter
Sleep 2.5s
