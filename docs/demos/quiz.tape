# Recorded by docs/demos/render.sh, which fills in the theme from theme.json.
# Don't run vhs on this file directly.
Output docs/demos/.frames/quiz/
Set Shell bash
Set FontSize 15
Set Width 1000
Set Height 560
Set Padding 24
Set TypingSpeed 60ms
Set Theme @theme.json
Set Framerate 50

Sleep 400ms
Type "terminal-of-terror quiz -n 3"
Sleep 300ms
Enter
Sleep 2.5s
Type "1"
Sleep 3s
Enter
Sleep 2.5s
Type "1"
Sleep 3.5s
Enter
Sleep 2.5s
Type "2"
Sleep 3s
Enter
Sleep 3.5s
