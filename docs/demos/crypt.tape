# Recorded by docs/demos/render.sh, which fills in the theme from theme.json.
# Don't run vhs on this file directly.
Output docs/demos/.frames/crypt/
Set Shell bash
Set FontSize 14
Set Width 1000
Set Height 760
Set Padding 24
Set TypingSpeed 60ms
Set Theme @theme.json
Set Framerate 50

Type "terminal-of-terror crypt --pack universal"
Enter
Sleep 2s
