# Recorded by docs/demos/render.sh, which fills in the theme from theme.json.
# Don't run vhs on this file directly.
Output docs/demos/.frames/list/
Set Shell bash
Set FontSize 14
Set Width 1200
Set Height 720
Set Padding 24
Set TypingSpeed 60ms
Set Theme @theme.json
Set Framerate 50

Type "terminal-of-terror list"
Enter
Sleep 2s
