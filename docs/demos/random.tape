# Recorded by docs/demos/render.sh, which fills in the theme from theme.json.
# Don't run vhs on this file directly.
Output docs/demos/.frames/random/
Set Shell bash
Set FontSize 15
Set Width 900
Set Height 340
Set Padding 24
Set TypingSpeed 60ms
Set Theme @theme.json
Set Framerate 50

Type "terminal-of-terror random --date 2026-11-21"
Enter
Sleep 2s
